# Shopify App (required)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://YOUR-PRODUCTION-DOMAIN
SCOPES=read_products,write_products,write_app_proxy

# Optional: custom shop domain (only if your store uses one)
# SHOP_CUSTOM_DOMAIN=

# Database — SQLite (Session storage only; orders are not persisted)
# Local development:
DATABASE_URL=file:./prisma/dev.sqlite
# Render with persistent disk (example):
# DATABASE_URL=file:/data/production.sqlite

# Order email (Resend)
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=

# Legacy email aliases (optional; used if ORDER_* vars are not set)
# EMAIL_FROM=
# SELLER_EMAIL=

# Optional outbound webhook after successful order email
# MSC_ORDER_WEBHOOK_URL=
# MSC_ORDER_WEBHOOK_SECRET=

# Runtime
NODE_ENV=production

# Local dev only (Shopify CLI / Vite)
# PORT=3000
# FRONTEND_PORT=8002

{%- comment -%}
  TABLE OF CONTENTS
  - Asset loading (CSS)
  - Catalog root container and App Proxy configuration
  - Header
  - Loading and status state
  - Product grid
  - Product detail modal
  - Cart drawer
  - Checkout modal
  - Asset loading (JavaScript)
  - Liquid schema
{%- endcomment -%}

{%- comment -%}
==================================================
ASSET LOADING (CSS)
==================================================
{%- endcomment -%}
{{ 'msc-catalog.css' | asset_url | stylesheet_tag }}

<style>
  /* Hide theme announcement bar on MSC catalog pages */
  body:has(.msc-catalog) .announcement-bar-section,
  body:has(.msc-catalog) .shopify-section-announcement-bar,
  body:has(.msc-catalog) section[id*="announcement"],
  body:has(.msc-catalog) .announcement-bar {
    display: none !important;
  }

  /* Remove extra top space from theme layout around the catalog block */
  body:has(.msc-catalog) #MainContent,
  body:has(.msc-catalog) main#MainContent,
  body:has(.msc-catalog) .shopify-section:has([data-msc-root]),
  body:has(.msc-catalog) .shopify-section:has(.msc-catalog) {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  /* Hide theme main menu on MSC catalog pages; keep store name/logo visible */
  body:has(.msc-catalog) .header__inline-menu,
  body:has(.msc-catalog) nav.header__inline-menu,
  body:has(.msc-catalog) .header__icon--menu,
  body:has(.msc-catalog) header-drawer,
  body:has(.msc-catalog) .menu-drawer-container,
  body:has(.msc-catalog) .site-nav,
  body:has(.msc-catalog) .site-header__nav,
  body:has(.msc-catalog) .site-header__links {
    display: none !important;
  }

  /* Keep theme header visible and stuck at top while scrolling */
  body:has(.msc-catalog) sticky-header,
  body:has(.msc-catalog) .header-wrapper,
  body:has(.msc-catalog) .section-header,
  body:has(.msc-catalog) .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    isolation: isolate;
    transform: none !important;
    overflow: visible;
    background: var(--gradient-background, rgb(var(--color-background, 255 255 255)));
  }

  body:has(.msc-catalog) sticky-header.shopify-section-header-hidden,
  body:has(.msc-catalog) .shopify-section-header-hidden {
    transform: none !important;
    top: 0 !important;
  }

  body:has(.msc-catalog) .shopify-section-group-header-group {
    overflow: visible;
  }

  body:has(.msc-catalog) .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    isolation: isolate;
    transform: none !important;
    background: var(--gradient-background, rgb(var(--color-background, 255 255 255)));
    grid-template-areas: "heading icons" !important;
    grid-template-columns: minmax(0, 1fr) auto !important;
    column-gap: 1.5rem;
    padding-block: 0.75rem !important;
  }

  body:has(.msc-catalog) .header__heading,
  body:has(.msc-catalog) .header__heading-link {
    justify-self: start;
    min-width: 0;
    max-width: 100%;
  }

  body:has(.msc-catalog) .header__heading-link {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  body:has(.msc-catalog) .header__icons .header__icon--cart,
  body:has(.msc-catalog) .header__icons #cart-icon-bubble,
  body:has(.msc-catalog) .header__icons cart-drawer,
  body:has(.msc-catalog) .header__icons .cart-count-bubble {
    display: none !important;
  }

  body:has(.msc-catalog) .header__icons {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    flex-shrink: 0;
    gap: 6px;
    overflow: visible;
  }

  body:has(.msc-catalog) .header [data-msc-open-cart],
  body:has(.msc-catalog) sticky-header [data-msc-open-cart],
  body:has(.msc-catalog) .header-wrapper [data-msc-open-cart] {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    body:has(.msc-catalog) .header {
      padding-block: 0.65rem !important;
    }
  }
</style>

{%- comment -%}
==================================================
CATALOG ROOT CONTAINER AND APP PROXY CONFIGURATION
==================================================
{%- endcomment -%}
<div
  id="msc-catalog-{{ block.id }}"
  class="msc-catalog"
  data-msc-root
  data-products-url="/apps/msc/products"
  data-order-url="/apps/msc/order"
  data-request-url="/apps/msc/order"
  data-click-url="/apps/msc/click"
  data-currency="{{ shop.currency | default: 'MXN' | escape }}"
  data-seller-whatsapp="{{ block.settings.whatsapp_number | default: '525633244119' | escape }}"
  data-header-logo-url="{{ 'minisupercoreano-logo.png' | asset_url }}"
  data-cart-label="{{ block.settings.cart_label | default: 'Lista' | escape }}"
>
  <div class="msc-container">
    {%- comment -%}
    ==================================================
    LOADING AND STATUS STATE
    ==================================================
    {%- endcomment -%}
    <div class="msc-status" data-msc-status>Cargando productos...</div>
    {%- comment -%}
    ==================================================
    PRODUCT GRID
    ==================================================
    {%- endcomment -%}
    <div class="msc-products-grid" data-msc-products-grid aria-live="polite"></div>
  </div>

  {%- comment -%}
  ==================================================
  PRODUCT DETAIL MODAL
  ==================================================
  {%- endcomment -%}
  <div class="msc-overlay" data-msc-product-modal aria-hidden="true" hidden>
    <button type="button" class="msc-overlay-background" data-msc-close-product aria-label="Cerrar"></button>

    <section class="msc-product-dialog" role="dialog" aria-modal="true" aria-label="Información del producto">
      <button type="button" class="msc-close-button" data-msc-close-product aria-label="Cerrar">×</button>

      <div class="msc-product-detail">
        <div class="msc-product-detail-media">
          <img class="msc-product-detail-image" data-msc-modal-image src="" alt="" width="700" height="700">
          <div class="msc-product-detail-placeholder" data-msc-modal-placeholder hidden>Sin imagen</div>
        </div>

        <div class="msc-product-detail-content">
          <h3 class="msc-product-detail-title" data-msc-modal-title></h3>
          <div class="msc-product-detail-price" data-msc-modal-price></div>
          <div class="msc-product-detail-description" data-msc-modal-description></div>

          <div class="msc-quantity-section">
            <span class="msc-quantity-label">Cantidad</span>
            <div class="msc-quantity-control">
              <button type="button" data-msc-modal-minus aria-label="Reducir cantidad">−</button>
              <span data-msc-modal-quantity>1</span>
              <button type="button" data-msc-modal-plus aria-label="Aumentar cantidad">+</button>
            </div>
          </div>

          <button type="button" class="msc-primary-button" data-msc-add-cart>Agregar a la lista</button>
        </div>
      </div>
    </section>
  </div>

  {%- comment -%}
  ==================================================
  CART DRAWER
  ==================================================
  {%- endcomment -%}
  <div class="msc-cart-drawer msc-modal-overlay" data-msc-cart-drawer aria-hidden="true" hidden>
    <button type="button" class="msc-modal-backdrop msc-cart-backdrop" data-msc-close-cart aria-label="Cerrar lista"></button>

    <aside class="msc-cart-panel msc-modal-window" role="dialog" aria-modal="true" aria-label="Lista de compra">
      <header class="msc-modal-header msc-cart-header">
        <h3>Lista de compra</h3>
        <button type="button" class="msc-modal-close msc-cart-close" data-msc-close-cart aria-label="Cerrar">×</button>
      </header>

      <div class="msc-modal-body msc-cart-body">
        <div class="msc-cart-items" data-msc-cart-items></div>
        <div class="msc-cart-empty" data-msc-cart-empty>Tu lista está vacía.</div>
      </div>

      <footer class="msc-modal-footer msc-cart-footer">
        <div class="msc-cart-total-row">
          <span>Total</span>
          <strong data-msc-cart-total>$0.00</strong>
        </div>

        <button type="button" class="msc-primary-button" data-msc-open-checkout disabled>Continuar</button>
      </footer>
    </aside>
  </div>

  {%- comment -%}
  ==================================================
  CHECKOUT MODAL
  ==================================================
  {%- endcomment -%}
  <div class="msc-checkout-overlay msc-modal-overlay" data-msc-checkout-modal aria-hidden="true" hidden>
    <button type="button" class="msc-modal-backdrop" data-msc-close-checkout aria-label="Cerrar"></button>

    <section class="msc-checkout-dialog msc-modal-window" role="dialog" aria-modal="true" aria-label="Datos del comprador">
      <header class="msc-modal-header msc-checkout-header">
        <h3>Datos del comprador</h3>
        <button type="button" class="msc-modal-close msc-checkout-close" data-msc-close-checkout aria-label="Cerrar formulario">×</button>
      </header>

      <div class="msc-modal-body msc-checkout-inner">
        <div class="msc-checkout-form-panel" data-msc-checkout-form-panel>
        <form class="msc-checkout-form" data-msc-checkout-form>
          <div class="msc-form-grid">
            <div class="msc-field">
              <label for="msc-name-{{ block.id }}">Nombre completo *</label>
              <input id="msc-name-{{ block.id }}" type="text" name="name" autocomplete="name" required>
            </div>

            <div class="msc-field">
              <label for="msc-phone-{{ block.id }}">Teléfono / WhatsApp *</label>
              <input id="msc-phone-{{ block.id }}" type="tel" name="phone" autocomplete="tel" required>
            </div>

            <div class="msc-field msc-field-full">
              <label for="msc-address-{{ block.id }}">Dirección de entrega *</label>
              <input
                id="msc-address-{{ block.id }}"
                type="text"
                name="address"
                autocomplete="street-address"
                placeholder="Calle y número"
                required
              >
              <p class="msc-field-hint">Esta es la dirección donde recibirá los productos de su pedido.</p>
            </div>

            <div class="msc-field">
              <label for="msc-exterior-{{ block.id }}">Número exterior *</label>
              <input id="msc-exterior-{{ block.id }}" type="text" name="exteriorNumber" required>
            </div>

            <div class="msc-field">
              <label for="msc-interior-{{ block.id }}">Número interior</label>
              <input id="msc-interior-{{ block.id }}" type="text" name="interiorNumber">
            </div>

            <div class="msc-field">
              <label for="msc-postal-{{ block.id }}">Código Postal *</label>
              <input
                id="msc-postal-{{ block.id }}"
                type="text"
                name="postalCode"
                inputmode="numeric"
                maxlength="5"
                autocomplete="postal-code"
                required
              >
            </div>

            <div class="msc-field">
              <label for="msc-colonia-{{ block.id }}">Colonia *</label>
              <input
                id="msc-colonia-{{ block.id }}"
                type="text"
                name="colonia"
                required
              >
            </div>

            <div class="msc-field">
              <label for="msc-municipality-{{ block.id }}">Alcaldía / Municipio *</label>
              <input
                id="msc-municipality-{{ block.id }}"
                type="text"
                name="municipality"
                required
              >
            </div>

            <div class="msc-field">
              <label for="msc-state-{{ block.id }}">Estado *</label>
              <input
                id="msc-state-{{ block.id }}"
                type="text"
                name="state"
                value="Ciudad de México"
                required
              >
            </div>

            <div class="msc-field msc-field-full">
              <label for="msc-email-{{ block.id }}">Correo electrónico</label>
              <input id="msc-email-{{ block.id }}" type="email" name="email" autocomplete="email">
            </div>

            <div class="msc-field msc-field-full">
              <label for="msc-reference-{{ block.id }}">Referencias</label>
              <textarea
                id="msc-reference-{{ block.id }}"
                name="reference"
                rows="2"
                placeholder="Entre qué calles, color del edificio, puntos de referencia..."
              ></textarea>
            </div>
          </div>

          <section class="msc-order-summary msc-order-summary--checkout">
            <h4 class="msc-order-summary-title">Resumen del pedido</h4>
            <div class="msc-order-summary-items" data-msc-checkout-items aria-hidden="true"></div>

            <div class="msc-order-total">
              <strong>Total</strong>
              <strong data-msc-checkout-total>$0.00</strong>
            </div>
          </section>

          <button type="submit" class="msc-submit-button" data-msc-submit>Enviar pedido</button>
          <p class="msc-form-message" data-msc-message></p>

          <button type="button" class="msc-whatsapp-button" data-msc-whatsapp-info>
            Enviar información por WhatsApp
          </button>

          <button
            type="button"
            class="msc-dev-whatsapp-test"
            data-msc-dev-whatsapp-test
            hidden
          >
            Probar mensaje de WhatsApp
          </button>
        </form>
        </div>

        <div
          class="msc-order-success-panel"
          data-msc-success-modal
          hidden
          aria-hidden="true"
        >
          <div class="msc-order-success-dialog">
            <p class="msc-order-success-message" data-msc-success-message></p>
            <p class="msc-form-message" data-msc-success-error hidden></p>
            <button type="button" class="msc-whatsapp-button" data-msc-success-whatsapp>
              Enviar por WhatsApp
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <button type="button" class="msc-list-button" data-msc-open-cart aria-label="Abrir lista de compra">
    <span aria-hidden="true">🛒</span>
    <span>{{ block.settings.cart_label | default: 'Lista' | escape }}</span>
    <span class="msc-list-count" data-msc-cart-count>0</span>
  </button>
</div>

{%- comment -%}
==================================================
ASSET LOADING (JAVASCRIPT)
==================================================
{%- endcomment -%}
<script src="{{ 'msc-catalog.js' | asset_url }}" defer></script>

{%- comment -%}
==================================================
LIQUID SCHEMA
==================================================
{%- endcomment -%}
{% schema %}
{
  "name": "MSC Catalog",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Productos"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Compra fácilmente por WhatsApp"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Texto de la lista",
      "default": "Lista"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp del vendedor",
      "default": "525633244119",
      "info": "Solo dígitos, sin +, espacios ni guiones. Ejemplo: 525633244119"
    }
  ]
}
{% endschema %}
